<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth 콜백 — STG 빌드 전용 스킴(gachimeokjastg). 프로덕션 앱(gachimeokja)과
                 겹치면 로그인 복귀 시 OS가 앱 선택창을 띄운다. src/lib/db.js의 NATIVE_OAUTH_REDIRECT
                 (IS_STG 분기)와 짝을 이룬다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gachimeokjastg" android:host="oauth-callback" />
            </intent-filter>

            <!-- 초대링크(App Links) — /join, /pot 경로만 좁게 열어준다. 프로덕션 앱과 동일한
                 도메인을 선언하므로 assetlinks.json에 이 앱(com.gachimeokja.app)의 서명 인증서
                 지문도 등록돼 있어야 정상 검증된다(public/.well-known/assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.eat-together.net" android:pathPrefix="/join" />
                <data android:scheme="https" android:host="www.eat-together.net" android:pathPrefix="/pot" />
                <data android:scheme="https" android:host="eat-together.net" android:pathPrefix="/join" />
                <data android:scheme="https" android:host="eat-together.net" android:pathPrefix="/pot" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM 상태바 알림 아이콘 — 지정 안 하면 컬러 런처 아이콘을 그대로 써서 상태바에서
             뭉개진 회색 사각형처럼 보인다. scripts/generate-icons.mjs가 흰색 실루엣으로 생성. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_notify" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
